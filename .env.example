# Browser configuration. Copy to .env and fill in your own Supabase project.
# The app starts against these values. It does not ship a second set of keys.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Optional. Used only when a template image URL is built in the browser.
# Uploads still use the Cloudinary secrets on the server.
VITE_CLOUDINARY_CLOUD_NAME=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets
# Set these in the Supabase dashboard (Project Settings → Edge Functions → Secrets)
# or with `supabase secrets set NAME=value`. They are not read from this file
# by the Vite app. When a secret is missing, the feature stops and names the key.
# ---------------------------------------------------------------------------

# Required to run the hosted project at all (injected by Supabase in production).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# AI copy, the marketing brain, and the visual-editor rewrite menu.
# At least one of these must be set or those calls fail with a clear error.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Template generation that goes through the Lovable AI gateway.
# LOVABLE_API_KEY=

# Image generation in AI Studio (OpenAI images). Uses OPENAI_API_KEY above.
# Video generation in AI Studio.
# RUNWARE_API_KEY=

# Alternate image and video providers. Runway, Kling, and Veo are not implemented:
# a key is recognized, and the function still returns "not implemented".
# LEONARDO_API_KEY=
# IDEOGRAM_API_KEY=
# RUNWAY_API_KEY=
# KLING_API_KEY=
# VEO_API_KEY=

# Stock search and template import. A missing key returns an empty result and an error.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=

# Brand kit import from a public site.
# BRANDFETCH_API_KEY=

# Media uploads and template preview hosting.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Billing. Checkout stays unavailable until both Flutterwave values and SITE_URL are set.
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_SECRET_HASH=
# SITE_URL=http://localhost:8080

# Ad publishing. Credentials can be stored, but the publish function does not send ads yet.
# META_ACCESS_TOKEN=
# META_PAGE_ID=
# META_AD_ACCOUNT_ID=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_ADVERTISER_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ACCESS_TOKEN=
